# Dockerfile for Control Plane (The Brain)
# This runs the Python application that issues DIDs, verifies VCs, and bridges to cloud

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY control-plane/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install Flask for API and dashboard
RUN pip install --no-cache-dir flask flask-cors

# Copy application code
COPY control-plane/ /app/

# Create data directory
RUN mkdir -p /app/data

# Expose ports
# 5000: API for sidecar to call
# 5001: Dashboard UI
EXPOSE 5000 5001

# Default command (can be overridden in docker-compose)
CMD ["python", "src/dashboard/app.py"]
