# Authorization Server
AUTH_SERVER_HOST=localhost
AUTH_SERVER_PORT=5000
AUTH_SERVER_SECRET_KEY=change-me-in-production-use-secrets-token-urlsafe-32

# Resource Server
RESOURCE_SERVER_HOST=localhost
RESOURCE_SERVER_PORT=5001
RESOURCE_SERVER_SECRET_KEY=change-me-in-production-use-secrets-token-urlsafe-32

# Database
DATABASE_URL=sqlite:///data/oauth.db

# JWT Settings
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Security
BCRYPT_ROUNDS=12

# Development
FLASK_ENV=development
FLASK_DEBUG=True
