# Dockerfile for Sidecar (The Bouncer)
# This builds the Go proxy that intercepts all agent traffic

FROM golang:1.21-alpine AS builder

WORKDIR /build

# Copy Go module files
COPY sidecar/go.mod sidecar/go.sum* ./

# Download dependencies
RUN go mod download || true

# Copy source code
COPY sidecar/*.go ./

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o dac-sidecar .

# Final stage - minimal image
FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/dac-sidecar .

# Expose proxy port
EXPOSE 8080

# Run the sidecar
CMD ["./dac-sidecar"]
